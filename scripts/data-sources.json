{
  "_comment": "빌드 입력 데이터 출처 레지스트리 — Build Studio '데이터 출처/버전' 패널이 사용. latest_check{regex,pick,url?} 있으면 [최신 조회] 자동(url 생략 시 위 url 사용, pick=max|first). 없으면 수동.",
  "sources": [
    {
      "key": "juso_navi",
      "name": "도로명주소 내비게이션용DB 전체분",
      "category": "주소",
      "url": "https://business.juso.go.kr/addrlink/main.do",
      "period_fmt": "YYYYMM",
      "cycle": "월",
      "note": "지오코더 주소 원천(건물단위 주소+좌표). juso 자료제공 '내비게이션DB(전체분)'(SN 28). match_build_*.txt 사용",
      "latest_check": {
        "type": "json",
        "url": "https://business.juso.go.kr/api/jst/selectAttrbDBDwldList",
        "method": "POST",
        "body": {
          "rtlDtaDtlSn": "28",
          "year": "{year}",
          "month": "{month}",
          "expand": "Y"
        },
        "json_path": "results.allMonthFileList",
        "field": "crtrYm",
        "filter": {
          "isExist": "Y",
          "fileTypeNm": "NAVIDATA"
        },
        "pick": "max"
      },
      "build_input": {
        "dest": "staged/navi",
        "extract": "7z",
        "into": "dir"
      }
    },
    {
      "key": "sangga",
      "name": "소상공인시장진흥공단 상가(상권)정보",
      "category": "상가",
      "url": "https://www.data.go.kr/data/15083033/fileData.do",
      "period_fmt": "YYYY-MM-DD",
      "cycle": "분기",
      "note": "상호·업종(POI/상가). data.go.kr 수정일 기준",
      "latest_check": {
        "regex": "수정일[\\s\\S]{0,120}?(\\d{4}-\\d{2}-\\d{2})",
        "pick": "first"
      },
      "build_input": {
        "dest": "poi-all",
        "extract": null,
        "into": "dir"
      }
    },
    {
      "key": "localdata",
      "name": "LOCALDATA 인허가 전체분",
      "category": "인허가",
      "url": "https://www.localdata.go.kr/",
      "period_fmt": "YYYYMMDD",
      "cycle": "일",
      "note": "지자체 인허가(업소) 전체분. 자동조회 미지원(localdata.go.kr 로그인/세션·API키 필요로 단순 GET 불가) — 현재 수동 등록",
      "build_input": {
        "dest": "staged/localdata",
        "extract": null,
        "into": "dir"
      }
    },
    {
      "key": "building_db",
      "name": "GIS건물통합정보 (건물DB)",
      "category": "건물",
      "url": "https://www.vworld.kr/dtmk/dtmk_ntads_s002.do?svcCde=NA&dsId=18",
      "period_fmt": "YYYY-MM-DD",
      "cycle": "월(일 변경분)",
      "note": "건물 외곽·층수(3D 건물). VWorld 국가중점데이터 dsId=18",
      "latest_check": {
        "regex": "기준일\\s*<em[^>]*>\\s*(\\d{4}-\\d{2}-\\d{2})",
        "pick": "max"
      },
      "build_input": {
        "dest": "staged/gis",
        "extract": "zip",
        "into": "dir"
      }
    },
    {
      "key": "osm",
      "name": "OpenStreetMap (남한, geofabrik)",
      "category": "OSM",
      "url": "https://download.geofabrik.de/asia/south-korea.html",
      "period_fmt": "YYYY-MM-DD",
      "cycle": "일",
      "note": "base 벡터타일(도로·수계·지형) + 아파트 동(棟) 라벨 + 지오코더(역·지명·POI) 보강. south-korea-latest.osm.pbf",
      "latest_check": {
        "regex": "up to\\s*(\\d{4}-\\d{2}-\\d{2})",
        "pick": "first"
      },
      "build_input": {
        "dest": "staged/osm",
        "extract": null,
        "into": "dir",
        "note": "pbf — 벡터타일/osm.sqlite 변환은 별도(02) 필요"
      }
    }
  ]
}