# docker compose 가 자동으로 읽는 환경파일(server/ 작업 디렉토리 기준).
# ── 게이트웨이 외부 노출 포트 ──────────────────────────────────────
# 호스트 쪽 포트만 바꾼다. 컨테이너 내부는 항상 80(gateway-nginx 'listen 80').
# 게이트웨이가 $http_host(포트 포함)를 tileserver 에 넘기므로 스타일 내부 URL 도 이 포트로 자동 생성됨.
# 변경 시: docker compose up -d (gateway 재생성) + 방화벽에서 이 포트 개방.
GATEWAY_PORT=18080

# ── (선택) PostGIS 프로파일 자격증명/포트 ── 기본값은 docker-compose.yml 인라인. 필요 시 주석 해제.
# PGPORT=5433
# PGUSER=cuvia
# PGPASSWORD=cuvia
# PGDATABASE=cuvia
