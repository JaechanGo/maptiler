{
  "sources": {
    "poi": {
      "type": "vector",
      "url": "mbtiles://{poi}"
    }
  },
  "layers": [
    {
      "id": "poi-dot",
      "type": "circle",
      "source": "poi",
      "source-layer": "poi",
      "minzoom": 14,
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "cat1"
          ],
          [
            "음식",
            "식품"
          ],
          "#e8915a",
          [
            "소매"
          ],
          "#5b9bd5",
          [
            "보건의료",
            "건강"
          ],
          "#e06c75",
          [
            "생활",
            "수리·개인",
            "시설관리·임대"
          ],
          "#4db6ac",
          [
            "문화",
            "예술·스포츠"
          ],
          "#b18bd0",
          [
            "교육"
          ],
          "#81c784",
          [
            "숙박"
          ],
          "#e0a3c8",
          "#9aa6b2"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          1.4,
          16,
          2.6,
          18,
          4
        ],
        "circle-opacity": 0.85,
        "circle-stroke-width": 0.3,
        "circle-stroke-color": "hsl(214,62%,12%)"
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "poi",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": [
        "!",
        [
          "has",
          "point_count"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "KlokanTech Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          10,
          18,
          13
        ],
        "text-anchor": "top",
        "text-offset": [
          0,
          0.6
        ],
        "text-optional": true,
        "symbol-sort-key": [
          "get",
          "name"
        ]
      },
      "paint": {
        "text-color": "#e8edf2",
        "text-halo-color": "hsl(214,62%,12%)",
        "text-halo-width": 1.3
      }
    }
  ]
}